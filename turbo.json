{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VITE_CHESS_SERVER_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "VITE_CHESS_SERVER_URL"
      ]
    },
    "setup": {
      "cache": false
    },
    "@chess/server#build": {
      "outputs": []
    }
  },
  "globalDependencies": [
    ".env"
  ],
  "globalPassThroughEnv": [
    "TYPESAFE_API_KEY",
    "TYPESAFE_BASE_URL",
    "TYPESAFE_MODEL",
    "STOCKFISH_PATH",
    "CHESS_ORIGINS",
    "CHESS_SERVER_URL"
  ]
}
