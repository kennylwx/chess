{
  "name": "chess-monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "setup": "node scripts/setup.mjs && turbo run setup",
    "chess": "turbo build --filter=@kennylwx/cli... && pnpm --filter @kennylwx/cli start",
    "cli:install": "turbo build --filter=@kennylwx/cli... && pnpm link --global ./apps/cli"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^6.0.3"
  }
}
